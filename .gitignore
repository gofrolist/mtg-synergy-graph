__pycache__/
.DS_Store
.claude/
.ecc/

# All data files (regenerable via scripts/)
# Use data/* (not data/) so negations below actually work — git can't
# re-include files under an ignored directory, only under an ignored path.
# Seed JSONs (rules/event maps/scoring weights) moved into the package
# at src/mtg_synergy_graph/data/ on 2026-06-09 so wheels ship them —
# no gitignore exception needed there (src/ is never ignored).
data/*
# …except the forge-oracle pin directory (committed: version.txt pins the
# Forge SHA used to build forge_oracle.db, which itself is regenerable).
!data/forge_oracle/
!data/forge_oracle/**

# Build artifacts
*.egg-info/
dist/
main.py

# Environment
.venv/
.env

# SQLite database
mtg_synergy.db
.pytest_cache/
.ruff_cache/

# bench-audit hook output (regenerated per commit)
.audit/

# ce-code-review + other compound-engineering per-run artifacts
.context/
.ecc/
logs/
.coverage

# commit graph outputs, ignore the extraction cache
graphify-out/cache/

# mutmut artifacts (mutation testing — see [tool.mutmut] in pyproject.toml)
mutants/
