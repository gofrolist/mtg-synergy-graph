__pycache__/
.DS_Store
.claude/
.ecc/

# All data files (regenerable via scripts/)
# Use data/* (not data/) so negations below actually work — git can't
# re-include files under an ignored directory, only under an ignored path.
data/*
# …except seed JSONs — source of truth for declarative rules + event maps
!data/*_seed.json
# …and scoring_weights.json — source of truth for _RULE_QUALITY_MULTIPLIER
# and _FLAT_WEIGHT_OVERRIDES, loaded by universal_scorer at import time.
!data/scoring_weights.json
# …and the forge-oracle pin directory (committed: version.txt pins the
# Forge SHA used to build forge_oracle.db, which itself is regenerable).
!data/forge_oracle/
!data/forge_oracle/**

# Build artifacts
*.egg-info/
main.py

# Environment
.venv/
.env

# SQLite database
mtg_synergy.db
.pytest_cache/
.ruff_cache/

# bench-audit hook output (regenerated per commit)
.audit/

# ce-code-review + other compound-engineering per-run artifacts
.context/
.ecc/
logs/
.coverage

# commit graph outputs, ignore the extraction cache
graphify-out/cache/

# mutmut artifacts (mutation testing — see [tool.mutmut] in pyproject.toml)
mutants/
